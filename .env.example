# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider — switch between "gemini" and "openai"
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini

# Google AI Studio (Gemini)
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (GPT-4o)
# Get keys at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# Webhook Security
# Append this token to your Pub/Sub push subscription URL:
# https://your-host.com/webhook/gmail?token=<PUBSUB_VERIFICATION_TOKEN>
# ─────────────────────────────────────────────────────────────────────────────
PUBSUB_VERIFICATION_TOKEN=generate_a_long_random_string_here

# Google Cloud Pub/Sub Topic for Gmail push notifications
# Format: projects/YOUR_PROJECT_ID/topics/YOUR_TOPIC_NAME
# Required for POST /api/watch/start to work
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-notifications

# ─────────────────────────────────────────────────────────────────────────────
# Token Storage
# Local file path for dev. Replace with DB logic in production.
# IMPORTANT: ensure .tokens.json is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────
TOKEN_STORE_PATH=.tokens.json

# ───────────────────────────────────────────────────────────────────────────────
# Personalización — nombre y firma
# ───────────────────────────────────────────────────────────────────────────────
# Tu nombre / el del remitente que aparecerá en el system prompt.
OWNER_NAME=Tu Nombre Aquí
# Firma en texto plano. Usa \n para saltos de línea.
# Ejemplo: GMAIL_SIGNATURE=Tu Nombre\nCEO @ Tu Empresa\n+34 600 000 000
GMAIL_SIGNATURE=Tu Nombre\ntu@correo.com

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets — SOLO CAMBIA EL ID CADA AÑO
# ===========================================
# 1. Crea una copia de la plantilla del año anterior en Google Sheets
# 2. Compártela con el email del service_account (rol editor)
# 3. Copia el ID de la nueva hoja (el string largo en la URL entre /d/ y /edit)
# 4. Pégalo abajo en GOOGLE_SHEETS_ID
# 
# El sistema detecta automáticamente:
#   • Las columnas por su nombre (FECHA, KILOMETRAJE, EXCESO, etc.)
#   • La fila donde empiezan los datos (busca la primera fecha)
#   • La fila de cada día por su fecha
#   • El vehículo correcto por nombre (búsqueda aproximada)
# ─────────────────────────────────────────────────────────────────────────────
# Ruta al JSON de Service Account (no cambiar)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ID del Google Sheet de kilometraje — CAMBIAR CADA AÑO:
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# (Opcional) Hoja de ingresos/gastos — deshabilitada por ahora
# GOOGLE_SHEETS_INGRESOS_ID=your_ingresos_sheets_id_here

# PostgreSQL (Docker)
POSTGRES_DB=vehicle_bot
POSTGRES_USER=vehicle_bot
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://vehicle_bot:change_this_password@db:5432/vehicle_bot
