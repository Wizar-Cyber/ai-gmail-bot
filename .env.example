# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Webmail (IMAP) — Conexión principal
# ─────────────────────────────────────────────────────────────────────────────
# Servidor IMAP de tu proveedor de webmail (ej. mail.tudominio.com)
WEBMAIL_HOST=mail.tudominio.com
# Puerto IMAP con SSL (993) o sin SSL (143)
WEBMAIL_PORT=993
# true para TLS/SSL, false para conexión sin cifrar
WEBMAIL_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# Cuentas de correo (hasta 3)
# Deja vacías las que no uses. El bot leerá INBOX + Spam + Junk de cada una.
# ─────────────────────────────────────────────────────────────────────────────
WEBMAIL_USER_1=correo1@tudominio.com
WEBMAIL_PASS_1=contraseña1

WEBMAIL_USER_2=correo2@tudominio.com
WEBMAIL_PASS_2=contraseña2

WEBMAIL_USER_3=correo3@tudominio.com
WEBMAIL_PASS_3=contraseña3

# ─────────────────────────────────────────────────────────────────────────────
# Carpetas IMAP a revisar (separadas por coma)
# Por defecto: INBOX,Spam,Junk
# ─────────────────────────────────────────────────────────────────────────────
WEBMAIL_FOLDERS=INBOX,Spam,Junk

# ─────────────────────────────────────────────────────────────────────────────
# SMTP — para enviar respuestas automáticas (mismas credenciales que IMAP)
# ─────────────────────────────────────────────────────────────────────────────
# Por defecto usa el mismo host que WEBMAIL_HOST. Normalmente puerto 587 (STARTTLS).
WEBMAIL_SMTP_HOST=mail.tudominio.com
WEBMAIL_SMTP_PORT=587
WEBMAIL_SMTP_TLS=true

# ─────────────────────────────────────────────────────────────────────────────
# AI — Generación de respuestas con Gemini
# ─────────────────────────────────────────────────────────────────────────────
# La API key de Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_tu_gemini_key
# Modelo a usar (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Nombre que aparece en la firma de las respuestas
OWNER_NAME=Tu Nombre Aquí
# Firma que se añade al final de cada respuesta. Usa \n para saltos de línea.
GMAIL_SIGNATURE=Tu Nombre\ntu@correo.com

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline de kilometraje (PDF → Excel/Sheets)
# ─────────────────────────────────────────────────────────────────────────────
# Ruta donde se guardan los PDFs descargados
PDF_DOWNLOAD_DIR=data/pdfs
# Comando para ejecutar el pipeline Python
PIPELINE_CMD=python3 -m src.main
# Directorio de datos
DATA_DIR=data

# ─────────────────────────────────────────────────────────────────────────────
# Polling
# ─────────────────────────────────────────────────────────────────────────────
# Intervalo en ms entre revisiones de correo (default 30000 = 30s)
POLL_INTERVAL=30000

# ─────────────────────────────────────────────────────────────────────────────
# Google Sheets — SOLO CAMBIA EL ID CADA AÑO
# ===========================================
# 1. Crea una copia de la plantilla del año anterior en Google Sheets
# 2. Compártela con el email del service_account (rol editor)
# 3. Copia el ID de la nueva hoja (el string largo en la URL entre /d/ y /edit)
# 4. Pégalo abajo en GOOGLE_SHEETS_ID
#
# El sistema detecta automáticamente:
#   • Las columnas por su nombre (FECHA, KILOMETRAJE, EXCESO, etc.)
#   • La fila donde empiezan los datos (busca la primera fecha)
#   • La fila de cada día por su fecha
#   • El vehículo correcto por nombre (búsqueda aproximada)
# ─────────────────────────────────────────────────────────────────────────────
# Ruta al JSON de Service Account (no cambiar)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ID del Google Sheet de kilometraje — CAMBIAR CADA AÑO:
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# (Opcional) Hoja de ingresos/gastos — deshabilitada por ahora
# GOOGLE_SHEETS_INGRESOS_ID=your_ingresos_sheets_id_here

# PostgreSQL (Docker)
POSTGRES_DB=vehicle_bot
POSTGRES_USER=vehicle_bot
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://vehicle_bot:change_this_password@db:5432/vehicle_bot
