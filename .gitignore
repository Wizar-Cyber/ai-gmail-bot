.tokens.json
.tokens_send.json

# Google credentials — NEVER commit
service_account.json
*_service_account.json
credentials.json

# Logs
logs/
*.log

# TypeScript cache
*.tsbuildinfo

# Python cache
__pycache__/
*.pyc
*.pyo

# Runtime data
data/
!data/.gitkeep

# Watch state
watch-state.json
*.watch-state.json
